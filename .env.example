# Member Search — Environment Variables
# ======================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to source control.
#
# For local development the mock server runs on port 3001 by default.
# See the mock-server repo for setup: https://github.com/<org>/mock-server

# Controls whether the app routes API calls through the mock server ("mock")
# or the real backend ("live").
# Allowed values: "mock" | "live"
VITE_API_MODE="mock"

# Base URL for the mock API server (used when VITE_API_MODE="mock")
VITE_MOCK_API_BASE_URL="http://localhost:3001"

# Base URL for the real backend API (used when VITE_API_MODE="live")
# Injected via CI/CD secrets in staging and production — never commit real values here.
VITE_API_BASE_URL="https://claims-poc.dev.multiplan.com"
