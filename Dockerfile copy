FROM artifactory.multiplan.com/mpi_approved_images/node/node:22 as build

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm config set fetch-timeout 900000

RUN npm ci --no-audit --no-fund

# Copy source AFTER npm ci so code changes don't bust the dependency cache.
COPY . .

# ── Build-time environment variables ─────────────────────────────────────────
# VITE_ vars are baked into the JS bundle at Vite build time.
# They cannot be changed at runtime — Vite resolves them statically.
# Jenkins injects these via --build-arg in the shared pipeline.
# Never sourced from a .env file in source control.
#
# VITE_MOCK_API_BASE_URL
#   Full URL of the centralized mock server (dev/poc only).
#   The server strips the /ucp-mocksvc ingress prefix internally.
#
# VITE_MEMBER_SEARCH_URL / VITE_EMPLOYER_GROUP_URL
#   Base URLs for the Module Federation remote entry files.
#   vite.config.ts appends /remoteEntry.js to each value.
#   Must NOT have a trailing slash.
# ─────────────────────────────────────────────────────────────────────────────

ARG VITE_API_MODE=live
ARG VITE_API_BASE_URL=https://claims-poc.dev.multiplan.com/claimsearchservice
ARG VITE_MOCK_API_BASE_URL=https://claims-poc.dev.multiplan.com/ucp-mocksvc
ARG VITE_MEMBER_SEARCH_URL=https://claims-poc.dev.multiplan.com/ucp-member-search-ui
ARG VITE_EMPLOYER_GROUP_URL=https://claims-poc.dev.multiplan.com/ucp-group-search-ui
ARG VITE_BUILD_VERSION=local

ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_MOCK_API_BASE_URL=${VITE_MOCK_API_BASE_URL}
ENV VITE_MEMBER_SEARCH_URL=${VITE_MEMBER_SEARCH_URL}
ENV VITE_EMPLOYER_GROUP_URL=${VITE_EMPLOYER_GROUP_URL}
ENV VITE_BUILD_VERSION=${VITE_BUILD_VERSION}

RUN npm run build


# ══ Stage 2: Runtime ══════════════════════════════════════════════════════════
FROM artifactory.multiplan.com/mpi_approved_images/nginx/nginx1.23:latest as final

ENV USER=ucp-user
ENV UID=1001

WORKDIR /usr/share/nginx/html

COPY --from=build /app/dist /usr/share/nginx/html/ucp-client-match-ui

COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN adduser --uid $UID --disabled-password --gecos "" --no-create-home $USER

RUN chown -R $USER:$USER /var/cache/nginx && \
    chown -R $USER:$USER /var/log/nginx && \
    chown -R $USER:$USER /usr/share/nginx && \
    chown -R $USER:$USER /usr/share/nginx/html/ucp-client-match-ui

RUN touch /var/run/nginx.pid && \
    chown -R $USER:$USER /var/run/nginx.pid && \
    chown -R $USER:$USER /usr/share/nginx/html/ucp-client-match-ui

USER $USER

EXPOSE 3000